# Required (unless using --mock / A11Y_COPILOT_MOCK below): your own
# Anthropic API key. a11y-copilot is free/open-source; the inference it uses
# is not, so this tool costs you API usage to run.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: set to "true" to skip Claude API calls everywhere and use
# templated explanations built from real scan data instead. Same effect as
# passing --mock on commands that support it. Good for trying the tool or
# developing on it without spending anything.
A11Y_COPILOT_MOCK=

