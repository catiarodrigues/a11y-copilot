{
  "name": "@catiarodrigues/a11y-copilot",
  "version": "0.1.1",
  "description": "An accessibility auditor built on a 3-agent pipeline (Planning, Execution, Validation) that scans a page, grounds fixes in WCAG/ARIA guidance via local RAG, and validates fixes by simulating them in a cloned DOM before reporting them as confirmed.",
  "keywords": [
    "a11y",
    "accessibility",
    "axe-core",
    "claude",
    "cli",
    "mcp",
    "playwright",
    "wcag"
  ],
  "homepage": "https://a11y-copilot.catiarodrigues.dev",
  "bugs": "https://github.com/catiarodrigues/a11y-copilot/issues",
  "license": "MIT",
  "author": "Cátia Rodrigues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catiarodrigues/a11y-copilot.git"
  },
  "bin": {
    "a11y-copilot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data/embeddings.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "dev": "tsx src/cli.ts",
    "build:rag": "tsx src/rag/buildIndex.ts",
    "pretest": "tsx src/rag/warmup.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run build:rag",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@axe-core/playwright": "^4.13.0",
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "playwright": "^1.48.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
